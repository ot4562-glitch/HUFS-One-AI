[Unit]
Description=HUFS One AI NCP-only approved Crawlee refresh (non-root)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hufs-crawler
Group=hufs-crawler
WorkingDirectory=/opt/hufs-one/current
Environment=NODE_ENV=production
Environment=HUFS_NCP_REFRESH_FACTORY=/etc/hufs-one/private/refresh-factory.mjs
Environment=CRAWLEE_STORAGE_DIR=/var/lib/hufs-one-crawler/crawlee
RuntimeDirectory=hufs-one-crawler
RuntimeDirectoryMode=0700
StateDirectory=hufs-one-crawler
StateDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/hufs-one-crawler/refresh.lock /usr/bin/node /opt/hufs-one/current/tools/ingestion/refresh-cli.mjs --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hufs-one-crawler /run/hufs-one-crawler
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=1500M
CPUQuota=100%
TimeoutStartSec=10min
