{
  "name": "hufs-one-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "workspaces": [
    "packages/contracts"
  ],
  "scripts": {
    "audit:entrypoints": "node tools/audit_entrypoints.mjs",
    "test:entrypoints": "node --test tools/tests/entrypoint-inventory.node.mjs",
    "audit:api-contracts": "node tools/audit_api_contracts.mjs",
    "test:api-contracts": "node --test tools/tests/api-contract-inventory.node.mjs",
    "audit:licenses": "node tools/audit_dependency_licenses.mjs",
    "audit:sbom": "node tools/dependency_bom.mjs",
    "test:dependency-evidence": "node --test tests/release/dependency_licenses.test.mjs tests/release/dependency_bom.test.mjs",
    "check": "npm run typecheck && npm run test",
    "typecheck": "npm run build:contracts && tsc --noEmit -p tsconfig.json",
    "test": "npm run build:contracts && vitest run",
    "test:contracts": "npm run build:contracts && vitest run tests/contracts",
    "test:consumers": "npm run build:contracts && vitest run tests/consumers",
    "test:consumer:ui": "npm run build:contracts && vitest run tests/consumers/ui-contract.test.ts",
    "test:consumer:recommendations": "npm run build:contracts && vitest run tests/consumers/recommendation-contract.test.ts",
    "test:consumer:academics": "npm run build:contracts && vitest run tests/consumers/academics-contract.test.ts",
    "test:consumer:api": "npm run build:contracts && vitest run tests/consumers/api-contract.test.ts",
    "test:watch": "npm run build:contracts && vitest",
    "test:api": "npm run build:contracts && vitest run tests/api",
    "build:api": "npm run build:contracts && tsc -p apps/api/tsconfig.build.json && node tools/strip_build_sourcemaps.mjs",
    "fixtures:generate": "npm run build:api && node tools/generate_synthetic_snapshots.mjs",
    "fixtures:check": "npm run build:api && node tools/generate_synthetic_snapshots.mjs --check",
    "admin:reviewer": "npm run build:api && node dist/apps/api/src/admin/reviewer-invite.js",
    "intake:plan": "npm run build:api && node dist/apps/api/src/admin/intake.js --plan",
    "intake:preview": "npm run build:api && node dist/apps/api/src/admin/intake.js --preview",
    "intake:apply": "npm run build:api && node dist/apps/api/src/admin/intake.js --apply",
    "start:api:local": "npm run build:api && node dist/apps/api/src/main.js",
    "start:api:synthetic-empty-demo": "npm run build:api && node dist/apps/api/src/dev/empty-demo-main.js --synthetic",
    "test:e2e:empty-demo": "npm run build:api && node tools/check_empty_demo_browser.mjs --start-servers",
    "assets:check": "node tools/generate_demo_assets.mjs --check && node tools/check_synthetic_artwork.mjs",
    "build:evaluation": "tsc -p tools/evaluation/tsconfig.json",
    "eval:review": "node tools/evaluation/run.mjs",
    "test:evaluation:cli": "node --test tools/evaluation/tests/cli.node.mjs tools/evaluation/tests/review-html.node.mjs",
    "start:api:synthetic-accounts": "npm run build:api && node dist/apps/api/src/dev/local-account-main.js --synthetic",
    "check:privacy": "python3 tools/verify_release_boundary.py",
    "build:contracts": "npm run build -w @hufs-one/contracts",
    "test:core": "npm run build:contracts && vitest run packages/core/src",
    "test:web": "npm run build:contracts && vitest run apps/web/src",
    "test:e2e:accounts": "npm run build:api && node tools/check_local_account_browser.mjs --start-servers",
    "dev:web": "npm run build:contracts && vite --config apps/web/vite.config.ts",
    "build:web": "npm run build:contracts && vite build --config apps/web/vite.config.ts",
    "test:e2e:web": "npm run build:contracts && playwright test -c apps/web/playwright.config.ts",
    "bench:normalization": "npm run build:contracts && tsc -p tsconfig.bench.json && node tools/bench_normalization.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.15",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "31.0.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "@types/pngjs": "6.0.5"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "jose": "6.2.14",
    "nodemailer": "10.3.1",
    "papaparse": "5.7.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0"
  }
}
